# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
# Android build cache (Gradle, CMake) written next to the project
/.utmp/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE and solution files (regenerated by Unity)
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports and builds
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# Blender backup files
*.blend1
*.blend2

# OS files
.DS_Store
Thumbs.db

# Placeholder art tooling
__pycache__/
SourceArt/Scripts/previews/

# Build simulator outputs
Tools/BuildSim/bin/
Tools/BuildSim/obj/
Tools/BuildSim/*.csv
Tools/BuildSim/results.json
!Tools/BuildSim/BuildSim.csproj

# Compile-check build output
/Tools/CompileCheck/bin/
/Tools/CompileCheck/obj/

# Playtest analysis output (regenerated by Tools/Playtest/analyze.py)
/PlaytestLogs/*/analysis/
