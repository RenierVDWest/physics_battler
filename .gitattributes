# Normalise line endings for text files
* text=auto

# Unity YAML and metas: always LF, so Windows and Linux checkouts agree
*.unity      text merge=unityyamlmerge eol=lf
*.prefab     text merge=unityyamlmerge eol=lf
*.asset      text merge=unityyamlmerge eol=lf
*.mat        text merge=unityyamlmerge eol=lf
*.anim       text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta       text eol=lf

# Code and data
*.cs         text diff=csharp
*.asmdef     text
*.json       text
*.py         text eol=lf

# Playtest logs are stored exactly as Unity wrote them: no line-ending conversion, no warnings
PlaytestLogs/** -text
*.gz         binary

# Binary art
*.fbx        binary
*.blend      binary
*.png        binary
*.jpg        binary
*.mp3        binary
*.wav        binary
*.ogg        binary
